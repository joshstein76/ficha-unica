# Copy to deploy/target.env (gitignored) once Josh picks the Hostinger plan. Nothing deploys without this file AND --go.
# TARGET_KIND: vps (root, systemd + Caddy) | cloud (Hostinger Cloud/shared: no root -> setsid daemon + cron watchdog)
TARGET_KIND=vps
SSH_HOST=REPLACE_ME            # e.g. 1.2.3.4 or an ~/.ssh/config alias
SSH_USER=REPLACE_ME
SSH_PORT=22
APP_DIR=/srv/fichaunica        # cloud: ~/fichaunica
DATA_DIR=/srv/fichaunica-data  # db, media, backups, logs (never inside the web root)
PYTHON=python3                 # must be >= 3.9 with Pillow available
