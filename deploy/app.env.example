# Lives ON THE SERVER at $DATA_DIR/app.env (chmod 600). Never commit real values.
LLAVE_ENV=production
LLAVE_BASE_DOMAIN=fichaunica.mx
LLAVE_SECRET=REPLACE_WITH_64_RANDOM_CHARS     # python3 -c "import secrets;print(secrets.token_urlsafe(48))"
LLAVE_DB=/srv/fichaunica-data/llave.db
LLAVE_MEDIA=/srv/fichaunica-data/media
LLAVE_BACKUP_DIR=/srv/fichaunica-data/backups
LLAVE_ALERT_LOG=/srv/fichaunica-data/logs/errors.log
LLAVE_PORT=8640
LLAVE_BIND=127.0.0.1
# Alerts (optional): webhook (e.g. a GHL inbound webhook -> internal contact) and/or email
LLAVE_ALERT_WEBHOOK=
LLAVE_ALERT_EMAIL_TO=
# Integrations stay OFF until Josh says yes:
# LLAVE_GHL_LIVE=1 (+ LLAVE_GHL_APPROVED_BY_JOSH=<date>)   LLAVE_ML_LIVE=1   ML_CLIENT_ID=  ML_CLIENT_SECRET=
# Live AI (Josh 10-18: approved, hard US$50/month cap). Stays OFF (smart templates) until a key exists.
# Key goes in config/anthropic.env on the server (copy config/anthropic.env.example, chmod 600), or ANTHROPIC_API_KEY here. Never commit it.
# LLAVE_AI_LIVE=1
# LLAVE_AI_MONTHLY_CAP_USD=50
# LLAVE_AI_KEY_FILE=/srv/fichaunica-data/anthropic.env
# Stripe subscriptions (docs/STRIPE-SETUP.md). Stays OFF (plan changes are free TEST MODE) until config/stripe.env is filled.
# On the server the file lives outside the release folder: copy config/stripe.env.example to /srv/fichaunica-data/stripe.env (chmod 600).
# LLAVE_STRIPE_ENV_FILE=/srv/fichaunica-data/stripe.env
# A live Stripe key is refused (the app won't start in production) unless this is set: only with Josh's explicit yes.
# LLAVE_STRIPE_LIVE=1

# Stripe TEST key in production (2026-11-03). While STRIPE_SECRET_KEY is a sk_test_ key, anyone could "pay" with card 4242 and get Pro free,
# so paid plans are CLOSED for everybody (the same "pagos muy pronto" page as Stripe off): checkout, the Billing Portal and the plan switch.
# Comma-separated login emails that may still run a test purchase (the owner's own). Empty = nobody. A live key lifts the lock (it needs LLAVE_STRIPE_LIVE=1).
# LLAVE_STRIPE_TEST_EMAILS=josh@example.com

# Email to agents (llave/mailer.py): new-lead alert, 5-minute "sigue sin respuesta", daily "Seguimiento hoy", buyer-alert match,
# and "¿Olvidaste tu contraseña?". Never to a client. Without SMTP every message is written to the outbox as dry_run, nothing is sent,
# and the forgot-password link on /entrar stays hidden. The error alerts above (LLAVE_ALERT_EMAIL_TO) use the same SMTP settings.
# Port 587 = STARTTLS, 465 = SSL, 25 = plain. This file is also sourced by cron: put quotes around any value with spaces or symbols.
# LLAVE_SMTP_HOST=smtp.example.com
# LLAVE_SMTP_PORT=587
# LLAVE_SMTP_USER=avisos@fichaunica.mx
# LLAVE_SMTP_PASSWORD='the mailbox password'
# LLAVE_SMTP_FROM=avisos@fichaunica.mx           # or "Ficha Única <avisos@fichaunica.mx>"; empty = the user above when it is an address
# Password-reset limits (production defaults shown; a link asked from one IP / for one email address per hour):
# LLAVE_RESET_PER_IP_HOUR=5
# LLAVE_RESET_PER_EMAIL_HOUR=3

# Own domains for Pro agents (docs/CUSTOM-DOMAINS.md). The server's public IPv4: shown to agents as the value of their A record, and the
# only address a domain may resolve to in order to be verified. Same IP as the 'A app' and 'A *' records of the brand domain.
LLAVE_PUBLIC_IP=REPLACE_WITH_THE_SERVER_PUBLIC_IPV4
# Name agents point www to with a CNAME. Default sites.<LLAVE_BASE_DOMAIN>; it must resolve to LLAVE_PUBLIC_IP (the wildcard 'A *' record does that).
# LLAVE_CNAME_TARGET=sites.fichaunica.mx
# Extra domains agents may never use as their own (the brand domain and LLAVE_MARKETING_URL's host are always refused), comma separated.
# LLAVE_OWN_DOMAINS=fichaunica.com
# 0 = do not visit a freshly verified domain to pre-issue its certificate (the first visitor then waits for it).
# LLAVE_DOMAIN_WARM=1
