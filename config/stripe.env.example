# Copy to config/stripe.env (gitignored). On the server keep it at /srv/fichaunica-data/stripe.env (chmod 600) and set
# LLAVE_STRIPE_ENV_FILE=/srv/fichaunica-data/stripe.env in app.env. Never commit it, never paste it in chat. Steps: docs/STRIPE-SETUP.md
# Start in Stripe TEST mode: the secret key starts with sk_test_ and the webhook secret with whsec_. A live key is refused
# unless LLAVE_STRIPE_LIVE=1 is set on the server (Josh's explicit yes).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...), not product ids (prod_...): MXN 499/month "Ficha Única Pro" and MXN 999/month "Ficha Única Pro + IA"
STRIPE_PRICE_PRO=
STRIPE_PRICE_IA=
